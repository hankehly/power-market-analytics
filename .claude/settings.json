{
  "permissions": {
    "allow": [
      "Bash(file *.csv)",
      "Bash(git check-ignore *)",
      "Bash(iconv:*)",
      "Bash(just --list)",
      "Bash(just dbt *)",
      "Bash(just open:*)",
      "Bash(just refresh-occto *)",
      "Bash(just refresh-tepco *)",
      "Bash(mdfind:*)",
      "Bash(uv sync:*)",
      "Bash(xxd)",
      "Skill(dataviz)",
      "Skill(dataviz:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:mlflow.org)",
      "WebFetch(domain:superset.apache.org)",
      "WebFetch(domain:www.data.jma.go.jp)",
      "WebFetch(domain:www.occto.or.jp)",
      "WebSearch",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_close",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_fill_form",
      "mcp__plugin_playwright_playwright__browser_find",
      "mcp__plugin_playwright_playwright__browser_hover",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_network_request",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_playwright_playwright__browser_select_option",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_tabs",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__superset__call_tool",
      "mcp__superset__get_instance_info",
      "mcp__superset__health_check",
      "mcp__superset__search_tools"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sort_permissions.py\"",
            "timeout": 15,
            "statusMessage": "Sorting permissions.allow"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) cd \"$CLAUDE_PROJECT_DIR\" && uv run ruff format \"$f\" && uv run ruff check --fix \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "ruff format + lint"
          }
        ]
      }
    ]
  }
}
